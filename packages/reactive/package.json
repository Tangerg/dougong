{
  "name": "@dougongjs/reactive",
  "version": "0.9.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "browserslist": [
    "Chrome >= 119",
    "Edge >= 119",
    "Firefox >= 124",
    "Safari >= 17.4"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "runtime",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "imports": {
    "#abort-listener": {
      "types": "./runtime/abort-listener.d.mts",
      "node": "./runtime/abort-listener.node.mjs",
      "default": "./runtime/abort-listener.web.mjs"
    }
  },
  "scripts": {
    "build": "node ../../tooling/generate-internal.mjs && vite build",
    "prepublishOnly": "node ../../tooling/generate-internal.mjs && vite build"
  },
  "description": "Zero-dependency signal, computed, batch and observe primitives.",
  "license": "MIT",
  "author": "Dougong contributors",
  "homepage": "https://tangerg.github.io/dougong/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tangerg/dougong.git",
    "directory": "packages/reactive"
  },
  "bugs": {
    "url": "https://github.com/Tangerg/dougong/issues"
  },
  "keywords": [
    "plugin",
    "plugin-system",
    "dependency-injection",
    "lifetime",
    "service-container",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  }
}
