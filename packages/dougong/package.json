{
  "name": "dougong",
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "browserslist": [
    "Chrome >= 119",
    "Edge >= 119",
    "Firefox >= 121",
    "Safari >= 17.4"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "prepublishOnly": "vite build"
  },
  "dependencies": {
    "@dougongjs/core": "workspace:*",
    "@dougongjs/platform": "workspace:*",
    "@dougongjs/reactive": "workspace:*"
  },
  "description": "Capability composition and structured lifetime kernel, plus its plugin distribution layer.",
  "license": "MIT",
  "author": "Dougong contributors",
  "homepage": "https://tangerg.github.io/dougong/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tangerg/dougong.git",
    "directory": "packages/dougong"
  },
  "bugs": {
    "url": "https://github.com/Tangerg/dougong/issues"
  },
  "keywords": [
    "plugin",
    "plugin-system",
    "dependency-injection",
    "lifetime",
    "service-container",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  }
}
