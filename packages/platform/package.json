{
  "name": "@dougongjs/platform",
  "version": "0.9.0",
  "type": "module",
  "engines": {
    "node": "^24.22.0 || >=26.10.0"
  },
  "browserslist": [
    "Chrome >= 119",
    "Edge >= 119",
    "Firefox >= 124",
    "Safari >= 17.4"
  ],
