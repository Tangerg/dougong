{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["script"],
  "workspaces": {
    ".": {
      "entry": ["tooling/**/*.{mjs,mts}"],
      "project": ["tooling/**/*.{mjs,mts}"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "examples": {
      "project": ["src/**/*.ts"]
    }
  }
}
