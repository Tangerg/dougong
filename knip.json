{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["tooling/**/*.mjs"],
      "project": ["tooling/**/*.mjs"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "examples": {
      "project": ["src/**/*.ts"]
    }
  }
}
