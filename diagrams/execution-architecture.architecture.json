  "cards": [
    {
      "dot": "emerald",
      "title": "One source of truth each",
      "items": [
        "Registry owns declarations; Engine owns the committed plan",
        "Host adds no state of its own \u2014 it serializes and publishes"
      ]
    },
    {
      "dot": "cyan",
      "title": "Only committed state is visible",
      "items": [
        "Setup declarations stay staged until the whole layer validates",
        "A failed change rolls back, or fails closed when it cannot"
      ]
    },
    {
      "dot": "rose",
      "title": "Platform compiles, never duplicates",
      "items": [
        "Manifest, permission and loading policy stay in Platform",
        "Permissions are a policy port \u2014 real isolation needs a Worker"
      ]
    }
  ]
