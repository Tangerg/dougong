  "cards": [
    {
      "dot": "emerald",
      "title": "Two independent foundations",
      "items": [
        "Core and reactive are joined by no edge because neither imports the other",
        "They meet only at get()/subscribe() and the Lifetime object protocol"
      ]
    },
    {
      "dot": "cyan",
      "title": "Direction is mechanical, not cultural",
      "items": [
        "Each Core and Platform module declares a rank and imports only lower ranks",
        "A rank without a file, and a file without a rank, both fail"
      ]
    },
    {
      "dot": "rose",
      "title": "Narrow runtime surface",
      "items": [
        "Core's only runtime dependency is the @standard-schema/spec type contract",
        "Any statement other than a re-export in the facade fails CI"
      ]
    }
  ]
