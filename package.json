{
  "name": "dougong-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "browserslist": [
    "Chrome >= 119",
    "Edge >= 119",
    "Firefox >= 121",
    "Safari >= 17.4"
  ],
  "scripts": {
    "build": "node tooling/build.mjs",
    "typecheck": "tsc --noEmit -p packages/reactive && tsc --noEmit -p packages/dougong && tsc --noEmit -p packages/platform && tsc --noEmit -p examples && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest --coverage.enabled=false",
    "lint": "oxlint packages examples tooling --deny-warnings",
    "lint:fix": "oxlint packages examples tooling --fix --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "check:circular": "node tooling/architecture/check-circular.mjs",
    "check:layers": "node tooling/architecture/check-layers.mjs",
    "check:api": "tsc --noEmit -p tsconfig.dist.json && node tooling/architecture/check-api-surface.mjs",
    "examples": "pnpm --filter @dougongjs/examples example",
    "examples:benchmark": "pnpm --filter @dougongjs/examples benchmark",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:check": "pnpm docs:build",
    "check": "pnpm check:generated && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm knip && pnpm check:circular && pnpm check:layers && pnpm build && pnpm check:api && pnpm check:consumer && pnpm docs:check",
    "release": "node tooling/release/release.mjs",
    "prepare": "husky",
    "generate:internal": "node tooling/generate-internal.mjs",
    "check:generated": "node tooling/generate-internal.mjs --check",
    "check:consumer": "node tooling/consumer/check-consumer.mjs"
  },
  "lint-staged": {
    "{packages/*,examples}/{src,test}/**/*.ts": [
      "prettier --write",
      "oxlint --fix --deny-warnings"
    ],
    "tooling/**/*.{mjs,mts}": [
      "prettier --write",
      "oxlint --fix --deny-warnings"
    ],
    "*.{json,ts,mjs}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "5.0.5",
    "husky": "^9.1.7",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "madge": "^8.0.0",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "semver": "^7.7.4",
    "tar": "^7.5.22",
    "typescript": "^5.9.2",
    "unplugin-dts": "^1.1.2",
    "vite": "^8.3.5",
    "vitepress": "2.0.0-alpha.19",
    "vitest": "5.0.5"
  }
}
